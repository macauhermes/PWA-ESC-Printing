# Public HTTPS origin is required for production WebAuthn and Web Push.
PORT=8787
APP_ORIGIN=http://localhost:5173
RP_ID=localhost
RP_NAME=PWA ESC Printing
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./uploads
SESSION_SECRET=replace-with-a-long-random-secret
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional first administrator username; registration should be invitation-controlled in production.
ALLOW_SELF_REGISTRATION=true