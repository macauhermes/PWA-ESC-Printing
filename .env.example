# Public HTTPS origin is required for production WebAuthn and Web Push.
PORT=8787
# Increment LOCAL_DB_SCHEMA_VERSION on the server and in src/main.tsx only when IndexedDB schema changes.
LOCAL_DB_SCHEMA_VERSION=2
# Shown in the full-screen confirmation before a schema-changing update clears local IndexedDB.
APP_UPDATE_SUMMARY=本次更新改善 IndexedDB 結構變更時的全螢幕確認流程，顯示目前與目標系統／資料庫版本，只有用戶確認後才會停止上傳、清除本機資料並重新載入。
APP_UPDATE_RISKS=確認後會永久清除本機暫存事件、上傳隊列、附件、打印機偏好及本機流水號；未上傳資料無法復原，已上傳到後台的工作記錄不受影響。
APP_ORIGIN=https://pwa.jasonhoi.com
RP_ID=pwa.jasonhoi.com
RP_NAME=PWA ESC Printing
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./uploads
SESSION_SECRET=replace-with-a-long-random-secret
# Single desktop-only administrator credentials. Change the example password before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jasonhoi.com
# Public Passkey registration is open to all ordinary users.