# Public HTTPS origin is required for production WebAuthn and Web Push.
PORT=8787
APP_ORIGIN=http://localhost:5173
RP_ID=localhost
RP_NAME=PWA ESC Printing
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./uploads
SESSION_SECRET=replace-with-a-long-random-secret
# Single desktop-only administrator credentials. Change the example password before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Public Passkey registration is open to all ordinary users.